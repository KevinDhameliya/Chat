<?xml version="1.0" encoding="utf-8"?>
<!-- Size is set in code (strip on Contact Profile vs. thumbnails in Media Viewer). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivThumb"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@color/reply_quote_background"
        android:contentDescription="@string/photo"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Connectly.Rounded8" />

    <View
        android:id="@+id/selection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_thumb_selected"
        android:visibility="gone" />
</FrameLayout>

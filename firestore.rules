rules_version = '2';

// Paste these into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Direct chats use the id "<uidA>_<uidB>", so membership can be read from the id.
    function isDirectMember(chatId) {
      return request.auth.uid in chatId.split('_');
    }

    // Group chats keep their member list in the chat document.
    function isGroupMember(chatId) {
      let path = /databases/$(database)/documents/chats/$(chatId);
      return exists(path) && request.auth.uid in get(path).data.participants;
    }

    // Any signed-in user can read profiles (needed for the contact list).
    // Only the owner can write their own profile.
    match /users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId;
    }

    // Status updates: everyone signed in can see them; only the owner posts or deletes.
    // Others may only add themselves to "viewers".
    match /statuses/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId;

      match /items/{itemId} {
        allow read: if signedIn();
        allow create, delete: if signedIn() && request.auth.uid == userId;
        allow update: if signedIn() && (
          request.auth.uid == userId ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers'])
        );
      }
    }

    // Call history: only the two people in a call can see it. Only the caller creates it;
    // either person may hide it from their own list.
    match /calls/{callId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.callerId == request.auth.uid
        && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenFor']);
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;

      allow create: if signedIn() && (
        isDirectMember(chatId) ||
        (request.resource.data.isGroup == true
          && request.resource.data.createdBy == request.auth.uid
          && request.auth.uid in request.resource.data.participants)
      );

      allow update: if signedIn() && (
        isDirectMember(chatId) || request.auth.uid in resource.data.participants
      );

      match /messages/{messageId} {
        allow read, create, update: if signedIn() &&
          (isDirectMember(chatId) || isGroupMember(chatId));
      }
    }
  }
}
